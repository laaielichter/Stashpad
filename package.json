{
  "name": "stashpad",
  "version": "0.2.2",
  "description": "Local memory for any AI agent: plain Markdown files with sources, dates, a review queue, search and optional encryption. CLI and MCP server, no dependencies.",
  "license": "MIT",
  "author": "laaielichter",
  "type": "module",
  "mcpName": "io.github.laaielichter/stashpad",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stashpad": "bin/stashpad.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bench": "node scripts/bench-search.mjs",
    "test": "node --test",
    "validate-memory": "node scripts/validate-memory.mjs",
    "port": "node scripts/port-file.mjs",
    "contract": "node scripts/update-contract.mjs",
    "prepublishOnly": "npm test"
  },
  "files": [
    ".claude-plugin",
    ".mcp.json",
    "hooks",
    "commands",
    "bin",
    "src",
    "skills",
    "docs",
    "AGENTS.md",
    "AGENT-GUIDE.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "third_party"
  ],
  "keywords": [
    "ai-agents",
    "agent-memory",
    "memory",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "local-first",
    "markdown",
    "claude-code",
    "codex",
    "cursor",
    "agents-md",
    "encryption",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laaielichter/stashpad.git"
  },
  "homepage": "https://github.com/laaielichter/stashpad#readme",
  "bugs": {
    "url": "https://github.com/laaielichter/stashpad/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
