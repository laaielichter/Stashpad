{
  "name": "stashpad",
  "version": "0.1.0",
  "description": "Local-first memory and context holder for AI agents. Readable, editable, source-tracked.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "stashpad": "bin/stashpad.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "bench": "node scripts/bench-search.mjs",
    "test": "node --test",
    "validate-memory": "node scripts/validate-memory.mjs",
    "port": "node scripts/port-file.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "docs",
    "AGENTS.md",
    "AGENT-GUIDE.md",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "third_party"
  ],
  "keywords": [
    "ai-agents",
    "agent-memory",
    "mcp",
    "model-context-protocol",
    "local-first",
    "markdown",
    "memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laaielichter/stashpad.git"
  },
  "homepage": "https://github.com/laaielichter/stashpad#readme",
  "bugs": {
    "url": "https://github.com/laaielichter/stashpad/issues"
  }
}
